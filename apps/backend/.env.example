# Backend environment. Copy to `.env` (git-ignored) and fill in the secrets:
#   cp apps/backend/.env.example apps/backend/.env
# Variables already set in the shell take precedence over this file.

# --- Secrets (required when NODE_ENV=production) ---
# Generate each with: openssl rand -hex 32
# Left empty in development, a random per-process value is used (restarts log everyone out).
JWT_SECRET=
OTP_PEPPER=

# --- Server ---
NODE_ENV=development
PORT=3000
# Origin allowed by CORS (the frontend URL).
CLIENT_ORIGIN=http://localhost:5173
# Behind a reverse proxy, set to the number of hops (e.g. 1) so rate limits see the client IP.
TRUST_PROXY=

# --- Storage ---
# flatdb directory, relative to the backend working directory.
DATABASE_DIR=data
